generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TripStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum TripCoverKind {
  photo
  map
}

enum LogEntryType {
  START_TRIP
  SAILS_UP
  ENGINE_ON
  ENGINE_OFF
  SAILS_DOWN
  ANCHOR_DROPPED
  ANCHOR_WEIGHED
  MOORED
  CAST_OFF
  END_TRIP
  NOTE
  HOURLY_LOG
  PHOTO
  VOICE_NOTE
  MEDIA
}

enum MediaType {
  photo
  voice
  attachment
}

model User {
  id                   String    @id
  name                 String
  email                String
  emailVerified        Boolean   @default(false)
  image                String?
  tutorialCompletedAt  DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  boats         Boat[]
  ownedCrewMembers       CrewMember[]   @relation("OwnedCrewMembers")
  linkedAsCrewMember     CrewMember[]   @relation("LinkedCrewMembers")
  sentCrewInvites        CrewInvite[]   @relation("SentCrewInvites")
  acceptedCrewInvites    CrewInvite[]   @relation("AcceptedCrewInvites")
  sentFriendRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Trip {
  id             String      @id @default(cuid())
  boatName       String
  registration   String?
  skipper        String?
  skipperKey     String?
  crewMemberIds  Json?
  title          String?
  subtitle       String?
  coverPhotoDataUrl String? @db.Text
  coverKind         TripCoverKind?
  boatId            String?
  boatPhotoUrl      String?
  boatIconId        String?
  startedAt      DateTime
  completedAt    DateTime?
  startLatitude  Float?
  startLongitude Float?
  startCountry   String?
  status         TripStatus  @default(PLANNED)
  sailsUp        Boolean?
  engineOn       Boolean?
  moored         Boolean?
  anchorDown     Boolean?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  logEntries     LogEntry[]
  legs           Leg[]
  tripTracks     TripTrack[]

  @@index([status, startedAt])
  @@map("trip")
}

model TripTrack {
  id          String   @id @default(cuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  legId       String?
  source      String
  kind        String   @default("position")
  encoding    String   @default("delta-v1")
  payload     Json?
  storage     String   @default("inline")
  storageKey  String?
  byteLength  Int?
  sha256      String?
  sampleCount Int
  startedAt   DateTime
  endedAt     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  synced      Boolean  @default(false)

  @@index([tripId, startedAt])
  @@index([synced, updatedAt])
  @@map("trip_track")
}

model DeletedTrip {
  id        String   @id
  deletedAt DateTime @default(now())

  @@map("deleted_trip")
}

model Leg {
  id           String    @id @default(cuid())
  tripId       String
  trip         Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sequence     Int
  title        String?
  startEventId String?
  endEventId   String?
  startedAt    DateTime
  endedAt      DateTime?
  color        String    @default("#7ec8e8")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  logEntries   LogEntry[]

  @@index([tripId, sequence])
  @@map("leg")
}

model LogEntry {
  id         String         @id @default(cuid())
  tripId     String
  trip       Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  legId      String?
  leg        Leg?           @relation(fields: [legId], references: [id], onDelete: SetNull)
  type       LogEntryType
  timestamp  DateTime
  latitude   Float?
  longitude  Float?
  accuracy   Float?
  heading    Float?
  createdBy  String?
  notes      String?
  data       Json?
  weather    Json?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  synced     Boolean        @default(false)
  deleted    Boolean        @default(false)
  media      Media[]

  @@index([tripId, timestamp])
  @@index([legId, timestamp])
  @@index([synced, updatedAt])
  @@map("log_entry")
}

model Media {
  id           String      @id @default(cuid())
  logEntryId   String
  logEntry     LogEntry    @relation(fields: [logEntryId], references: [id], onDelete: Cascade)
  type         MediaType
  order        Int         @default(0)
  localPath    String?
  remoteUrl    String?
  thumbnailUrl String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  synced       Boolean     @default(false)

  @@index([logEntryId, createdAt])
  @@index([logEntryId, order])
  @@index([synced, updatedAt])
  @@map("media")
}

model Boat {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  iconId    String      @default("medium")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  photos    BoatPhoto[]

  @@index([userId, updatedAt])
  @@map("boat")
}

model BoatPhoto {
  id        String   @id @default(cuid())
  boatId    String
  boat      Boat     @relation(fields: [boatId], references: [id], onDelete: Cascade)
  s3Key     String
  mimeType  String   @default("image/jpeg")
  caption   String?
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boatId, sortOrder])
  @@map("boat_photo")
}

enum CrewInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model CrewMember {
  id            String       @id @default(cuid())
  ownerUserId   String
  owner         User         @relation("OwnedCrewMembers", fields: [ownerUserId], references: [id], onDelete: Cascade)
  linkedUserId  String?
  linkedUser    User?        @relation("LinkedCrewMembers", fields: [linkedUserId], references: [id], onDelete: SetNull)
  displayName   String?
  photoS3Key    String?
  photoMimeType String?      @default("image/jpeg")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  invites       CrewInvite[]

  @@unique([ownerUserId, linkedUserId])
  @@index([ownerUserId])
  @@map("crew_member")
}

model CrewInvite {
  id               String           @id @default(cuid())
  crewMemberId     String
  crewMember       CrewMember       @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)
  inviterUserId    String
  inviter          User             @relation("SentCrewInvites", fields: [inviterUserId], references: [id], onDelete: Cascade)
  inviteeEmail     String
  token            String           @unique
  status           CrewInviteStatus @default(PENDING)
  acceptedByUserId String?
  acceptedBy       User?            @relation("AcceptedCrewInvites", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  expiresAt        DateTime
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  friendRequest    FriendRequest?

  @@index([inviterUserId, status])
  @@index([inviteeEmail, status])
  @@map("crew_invite")
}

model FriendRequest {
  id                 String              @id @default(cuid())
  requesterUserId    String
  requester          User                @relation("SentFriendRequests", fields: [requesterUserId], references: [id], onDelete: Cascade)
  addresseeUserId    String
  addressee          User                @relation("ReceivedFriendRequests", fields: [addresseeUserId], references: [id], onDelete: Cascade)
  status             FriendRequestStatus @default(PENDING)
  sourceCrewInviteId String?             @unique
  sourceCrewInvite   CrewInvite?         @relation(fields: [sourceCrewInviteId], references: [id], onDelete: SetNull)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([requesterUserId, addresseeUserId])
  @@index([addresseeUserId, status])
  @@map("friend_request")
}

model AdminJobLog {
  jobId     String   @id
  log       String   @default("")
  updatedAt DateTime @updatedAt

  @@map("admin_job_log")
}

enum RouteCoverKind {
  photo
  map
}

enum RouteAnnotationKind {
  comment
  photo
}

enum RouteMediaType {
  photo
  attachment
}

model Route {
  id                String          @id @default(cuid())
  title             String
  description       String?
  boatId            String?
  coverKind         RouteCoverKind?
  coverPhotoDataUrl String?         @db.Text
  source            String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  synced            Boolean         @default(false)

  waypoints   RouteWaypoint[]
  annotations RouteAnnotation[]

  @@index([updatedAt])
  @@map("route")
}

model RouteWaypoint {
  id          String   @id @default(cuid())
  routeId     String
  route       Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  sequence    Int
  name        String?
  description String?
  symbol      String?
  latitude    Float
  longitude   Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  synced      Boolean  @default(false)

  annotations RouteAnnotation[]

  @@index([routeId, sequence])
  @@map("route_waypoint")
}

model RouteAnnotation {
  id         String              @id @default(cuid())
  routeId    String
  route      Route               @relation(fields: [routeId], references: [id], onDelete: Cascade)
  waypointId String?
  waypoint   RouteWaypoint?      @relation(fields: [waypointId], references: [id], onDelete: SetNull)
  kind       RouteAnnotationKind
  body       String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  synced     Boolean             @default(false)
  deleted    Boolean             @default(false)

  media RouteMedia[]

  @@index([routeId, createdAt])
  @@index([synced, updatedAt])
  @@map("route_annotation")
}

model RouteMedia {
  id           String         @id @default(cuid())
  annotationId String
  annotation   RouteAnnotation @relation(fields: [annotationId], references: [id], onDelete: Cascade)
  type         RouteMediaType
  order        Int            @default(0)
  localPath    String?
  remoteUrl    String?
  thumbnailUrl String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  synced       Boolean        @default(false)

  @@index([annotationId, order])
  @@index([synced, updatedAt])
  @@map("route_media")
}

model DeletedRoute {
  id        String   @id
  deletedAt DateTime @default(now())

  @@map("deleted_route")
}
