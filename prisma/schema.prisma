generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TripStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum TripCoverKind {
  photo
  map
}

enum LogEntryType {
  START_TRIP
  SAILS_UP
  ENGINE_ON
  ENGINE_OFF
  SAILS_DOWN
  ANCHOR_DROPPED
  ANCHOR_WEIGHED
  MOORED
  CAST_OFF
  END_TRIP
  NOTE
  HOURLY_LOG
  PHOTO
  VOICE_NOTE
  MEDIA
}

enum MediaType {
  photo
  voice
  attachment
}

enum ConsortiumMemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum Visibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

model User {
  id                   String    @id
  name                 String
  email                String
  emailVerified        Boolean   @default(false)
  image                String?
  tutorialCompletedAt  DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  boats         Boat[]
  createdConsortia       Consortium[]      @relation("CreatedConsortia")
  consortiumMemberships  ConsortiumMember[]
  ownedCrewMembers       CrewMember[]   @relation("OwnedCrewMembers")
  linkedAsCrewMember     CrewMember[]   @relation("LinkedCrewMembers")
  sentCrewInvites        CrewInvite[]   @relation("SentCrewInvites")
  acceptedCrewInvites    CrewInvite[]   @relation("AcceptedCrewInvites")
  sentMemberInvites      MemberInvite[] @relation("SentMemberInvites")
  acceptedMemberInvites  MemberInvite[] @relation("AcceptedMemberInvites")
  boatMemberships        BoatMember[]
  sentFriendRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")
  createdTrips           Trip[]         @relation("CreatedTrips")
  createdRoutes          Route[]        @relation("CreatedRoutes")
  boatShareOwnerships    BoatShareOwner[]
  orgContacts           ConsortiumContact[]
  ownedBoatAssets       BoatAsset[]        @relation("BoatAssetOwner")
  loanedBoatAssets      BoatAsset[]        @relation("BoatAssetLoanFrom")
  expenseClaims         ExpenseClaim[]     @relation("ExpenseClaimClaimant")
  orgTransactions       OrgTransaction[]   @relation("OrgTransactionCounterparty")
  createdOrgTransactions OrgTransaction[]  @relation("OrgTransactionCreator")

  @@unique([email])
  @@map("user")
}

model Consortium {
  id              String     @id @default(cuid())
  name            String
  createdByUserId String
  visibility      Visibility @default(PRIVATE)
  shareToken      String?    @unique
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  createdBy User               @relation("CreatedConsortia", fields: [createdByUserId], references: [id], onDelete: Restrict)
  members   ConsortiumMember[]
  memberInvites MemberInvite[]
  boats     Boat[]
  photos    ConsortiumPhoto[]
  documentCategories ConsortiumDocumentCategory[]
  documents ConsortiumDocument[]
  contacts  ConsortiumContact[]
  bankAccounts OrgBankAccount[]
  transactions OrgTransaction[]
  expenseClaims ExpenseClaim[]
  boatPurchases BoatPurchase[]

  @@index([createdByUserId])
  @@map("consortium")
}

model ConsortiumMember {
  id           String               @id @default(cuid())
  consortiumId String
  userId       String
  role         ConsortiumMemberRole
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  consortium Consortium @relation(fields: [consortiumId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([consortiumId, userId])
  @@index([userId])
  @@map("consortium_member")
}

model ConsortiumPhoto {
  id            String     @id @default(cuid())
  consortiumId  String
  consortium    Consortium @relation(fields: [consortiumId], references: [id], onDelete: Cascade)
  s3Key         String
  mimeType      String     @default("image/jpeg")
  caption       String?
  isDefault     Boolean    @default(false)
  sortOrder     Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([consortiumId, sortOrder])
  @@map("consortium_photo")
}

model ConsortiumContact {
  id           String     @id @default(cuid())
  consortiumId String
  userId       String?
  consortium   Consortium @relation(fields: [consortiumId], references: [id], onDelete: Cascade)
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  displayName  String
  email        String?
  phone        String?
  whatsapp     String?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([consortiumId, userId])
  @@index([consortiumId, displayName])
  @@index([userId])
  @@map("consortium_contact")
}

model ConsortiumDocumentCategory {
  id           String     @id @default(cuid())
  consortiumId String
  consortium   Consortium @relation(fields: [consortiumId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  documents    ConsortiumDocument[]

  @@unique([consortiumId, name])
  @@index([consortiumId, sortOrder])
  @@map("consortium_document_category")
}

model ConsortiumDocument {
  id           String                     @id @default(cuid())
  consortiumId String
  consortium   Consortium                 @relation(fields: [consortiumId], references: [id], onDelete: Cascade)
  categoryId   String
  category     ConsortiumDocumentCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title        String
  purpose      DocumentPurpose?
  sortOrder    Int                        @default(0)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  versions     ConsortiumDocumentVersion[]
  expenseClaimLinks ExpenseClaimDocument[]

  @@index([consortiumId, categoryId, sortOrder])
  @@map("consortium_document")
}

model ConsortiumDocumentVersion {
  id            String           @id @default(cuid())
  documentId    String
  document      ConsortiumDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int
  kind          BoatDocumentKind
  s3Key         String?
  mimeType      String?
  url           String?
  fileName      String?
  createdAt     DateTime         @default(now())

  @@unique([documentId, versionNumber])
  @@index([documentId, versionNumber])
  @@map("consortium_document_version")
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Trip {
  id             String      @id @default(cuid())
  userId         String?
  boatName       String
  registration   String?
  skipper        String?
  skipperKey     String?
  crewMemberIds  Json?
  title          String?
  subtitle       String?
  coverPhotoDataUrl String? @db.Text
  coverKind         TripCoverKind?
  boatId            String?
  boatPhotoUrl      String?
  boatIconId        String?
  startedAt      DateTime
  completedAt    DateTime?
  startLatitude  Float?
  startLongitude Float?
  startCountry   String?
  status         TripStatus  @default(PLANNED)
  sailsUp        Boolean?
  engineOn       Boolean?
  moored         Boolean?
  anchorDown     Boolean?
  storyHtml         String?   @db.Text
  storyShareToken   String?   @unique
  storyUpdatedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  createdBy  User?        @relation("CreatedTrips", fields: [userId], references: [id], onDelete: SetNull)
  logEntries     LogEntry[]
  legs           Leg[]
  tripTracks     TripTrack[]
  storyMedia     TripStoryMedia[]

  @@index([status, startedAt])
  @@index([userId])
  @@index([boatId])
  @@map("trip")
}

model TripStoryMedia {
  id        String   @id @default(cuid())
  tripId    String
  s3Key     String
  mimeType  String
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_story_media")
}

model TripTrack {
  id          String   @id @default(cuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  legId       String?
  source      String
  kind        String   @default("position")
  encoding    String   @default("delta-v1")
  payload     Json?
  storage     String   @default("inline")
  storageKey  String?
  byteLength  Int?
  sha256      String?
  sampleCount Int
  startedAt   DateTime
  endedAt     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  synced      Boolean  @default(false)

  @@index([tripId, startedAt])
  @@index([synced, updatedAt])
  @@map("trip_track")
}

model DeletedTrip {
  id        String   @id
  deletedAt DateTime @default(now())

  @@map("deleted_trip")
}

model Leg {
  id           String    @id @default(cuid())
  tripId       String
  trip         Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sequence     Int
  title        String?
  startEventId String?
  endEventId   String?
  startedAt    DateTime
  endedAt      DateTime?
  color        String    @default("#7ec8e8")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  logEntries   LogEntry[]

  @@index([tripId, sequence])
  @@map("leg")
}

model LogEntry {
  id         String         @id @default(cuid())
  tripId     String
  trip       Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  legId      String?
  leg        Leg?           @relation(fields: [legId], references: [id], onDelete: SetNull)
  type       LogEntryType
  timestamp  DateTime
  latitude   Float?
  longitude  Float?
  accuracy   Float?
  heading    Float?
  createdBy  String?
  notes      String?
  data       Json?
  weather    Json?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  synced     Boolean        @default(false)
  deleted    Boolean        @default(false)
  media      Media[]

  @@index([tripId, timestamp])
  @@index([legId, timestamp])
  @@index([synced, updatedAt])
  @@map("log_entry")
}

model Media {
  id           String      @id @default(cuid())
  logEntryId   String
  logEntry     LogEntry    @relation(fields: [logEntryId], references: [id], onDelete: Cascade)
  type         MediaType
  order        Int         @default(0)
  localPath    String?
  remoteUrl    String?
  thumbnailUrl String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  synced       Boolean     @default(false)

  @@index([logEntryId, createdAt])
  @@index([logEntryId, order])
  @@index([synced, updatedAt])
  @@map("media")
}

enum BoatDocumentKind {
  upload
  link
}

enum DocumentPurpose {
  receipt
  invoice
  photo
  manual
  warranty
  other
}

enum AssetOwnership {
  BOAT
  ORG
  USER
  EXTERNAL
}

enum AssetWorkType {
  install
  service
  repair
  other
}

enum TransactionType {
  expense
  income
  transfer
  reimbursement
}

enum ExpenseClaimStatus {
  draft
  submitted
  approved
  paid
  rejected
}

model Boat {
  id                 String                 @id @default(cuid())
  consortiumId       String?
  userId             String
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  iconId             String                 @default("medium")
  shareCount         Int                    @default(1)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  consortium         Consortium?            @relation(fields: [consortiumId], references: [id], onDelete: SetNull)
  photos             BoatPhoto[]
  documentCategories BoatDocumentCategory[]
  documents          BoatDocument[]
  shares             BoatShare[]
  members            BoatMember[]
  memberInvites      MemberInvite[]
  assets             BoatAsset[]
  purchases          BoatPurchase[]
  assetWork          AssetWork[]
  orgTransactions    OrgTransaction[]
  expenseClaims      ExpenseClaim[]

  @@index([userId, updatedAt])
  @@index([consortiumId])
  @@map("boat")
}

model BoatShare {
  id        String   @id @default(cuid())
  boatId    String
  sequence  Int
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boat   Boat             @relation(fields: [boatId], references: [id], onDelete: Cascade)
  owners BoatShareOwner[]

  @@unique([boatId, sequence])
  @@index([boatId, sequence])
  @@map("boat_share")
}

model BoatShareOwner {
  id        String   @id @default(cuid())
  shareId   String
  userId    String
  createdAt DateTime @default(now())

  share BoatShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shareId, userId])
  @@index([userId])
  @@map("boat_share_owner")
}

model BoatPhoto {
  id        String   @id @default(cuid())
  boatId    String
  boat      Boat     @relation(fields: [boatId], references: [id], onDelete: Cascade)
  s3Key     String
  mimeType  String   @default("image/jpeg")
  caption   String?
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boatId, sortOrder])
  @@map("boat_photo")
}

model BoatDocumentCategory {
  id        String         @id @default(cuid())
  boatId    String
  boat      Boat           @relation(fields: [boatId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  documents BoatDocument[]

  @@unique([boatId, name])
  @@index([boatId, sortOrder])
  @@map("boat_document_category")
}

model BoatDocument {
  id         String                 @id @default(cuid())
  boatId     String
  boat       Boat                   @relation(fields: [boatId], references: [id], onDelete: Cascade)
  categoryId String
  category   BoatDocumentCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title      String
  purpose    DocumentPurpose?
  sortOrder  Int                    @default(0)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  versions   BoatDocumentVersion[]
  assetLinks    BoatAssetDocument[]
  purchaseLinks BoatPurchaseDocument[]
  workLinks     AssetWorkDocument[]

  @@index([boatId, categoryId, sortOrder])
  @@map("boat_document")
}

model BoatDocumentVersion {
  id            String           @id @default(cuid())
  documentId    String
  document      BoatDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int
  kind          BoatDocumentKind
  s3Key         String?
  mimeType      String?
  url           String?
  fileName      String?
  createdAt     DateTime         @default(now())

  @@unique([documentId, versionNumber])
  @@index([documentId, versionNumber])
  @@map("boat_document_version")
}

enum CrewInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum MemberInviteKind {
  ORG
  BOAT
}

model BoatMember {
  id        String               @id @default(cuid())
  boatId    String
  userId    String
  role      ConsortiumMemberRole
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  boat Boat @relation(fields: [boatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boatId, userId])
  @@index([userId])
  @@map("boat_member")
}

model MemberInvite {
  id               String               @id @default(cuid())
  kind             MemberInviteKind
  orgId            String?
  boatId           String?
  inviterUserId    String
  inviteeEmail     String?
  token            String               @unique
  role             ConsortiumMemberRole @default(MEMBER)
  status           CrewInviteStatus     @default(PENDING)
  acceptedByUserId String?
  expiresAt        DateTime
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  org        Consortium? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  boat       Boat?       @relation(fields: [boatId], references: [id], onDelete: Cascade)
  inviter    User        @relation("SentMemberInvites", fields: [inviterUserId], references: [id], onDelete: Cascade)
  acceptedBy User?       @relation("AcceptedMemberInvites", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([inviterUserId, status])
  @@index([inviteeEmail, status])
  @@index([orgId, status])
  @@index([boatId, status])
  @@map("member_invite")
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model CrewMember {
  id            String       @id @default(cuid())
  ownerUserId   String
  owner         User         @relation("OwnedCrewMembers", fields: [ownerUserId], references: [id], onDelete: Cascade)
  linkedUserId  String?
  linkedUser    User?        @relation("LinkedCrewMembers", fields: [linkedUserId], references: [id], onDelete: SetNull)
  displayName   String?
  photoS3Key    String?
  photoMimeType String?      @default("image/jpeg")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  invites       CrewInvite[]

  @@unique([ownerUserId, linkedUserId])
  @@index([ownerUserId])
  @@map("crew_member")
}

model CrewInvite {
  id               String           @id @default(cuid())
  crewMemberId     String
  crewMember       CrewMember       @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)
  inviterUserId    String
  inviter          User             @relation("SentCrewInvites", fields: [inviterUserId], references: [id], onDelete: Cascade)
  inviteeEmail     String
  token            String           @unique
  status           CrewInviteStatus @default(PENDING)
  acceptedByUserId String?
  acceptedBy       User?            @relation("AcceptedCrewInvites", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  expiresAt        DateTime
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  friendRequest    FriendRequest?

  @@index([inviterUserId, status])
  @@index([inviteeEmail, status])
  @@map("crew_invite")
}

model FriendRequest {
  id                 String              @id @default(cuid())
  requesterUserId    String
  requester          User                @relation("SentFriendRequests", fields: [requesterUserId], references: [id], onDelete: Cascade)
  addresseeUserId    String
  addressee          User                @relation("ReceivedFriendRequests", fields: [addresseeUserId], references: [id], onDelete: Cascade)
  status             FriendRequestStatus @default(PENDING)
  sourceCrewInviteId String?             @unique
  sourceCrewInvite   CrewInvite?         @relation(fields: [sourceCrewInviteId], references: [id], onDelete: SetNull)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([requesterUserId, addresseeUserId])
  @@index([addresseeUserId, status])
  @@map("friend_request")
}

model AdminJobLog {
  jobId     String   @id
  log       String   @default("")
  updatedAt DateTime @updatedAt

  @@map("admin_job_log")
}

enum RouteCoverKind {
  photo
  map
}

enum RouteAnnotationKind {
  comment
  photo
}

enum RouteMediaType {
  photo
  attachment
}

model Route {
  id                String          @id @default(cuid())
  userId            String?
  title             String
  description       String?
  boatId            String?
  coverKind         RouteCoverKind?
  coverPhotoDataUrl String?         @db.Text
  source            String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  synced            Boolean         @default(false)

  createdBy   User?         @relation("CreatedRoutes", fields: [userId], references: [id], onDelete: SetNull)
  waypoints   RouteWaypoint[]
  annotations RouteAnnotation[]

  @@index([updatedAt])
  @@index([userId])
  @@map("route")
}

model RouteWaypoint {
  id          String   @id @default(cuid())
  routeId     String
  route       Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  sequence    Int
  name        String?
  description String?
  symbol      String?
  latitude    Float
  longitude   Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  synced      Boolean  @default(false)

  annotations RouteAnnotation[]

  @@index([routeId, sequence])
  @@map("route_waypoint")
}

model RouteAnnotation {
  id         String              @id @default(cuid())
  routeId    String
  route      Route               @relation(fields: [routeId], references: [id], onDelete: Cascade)
  waypointId String?
  waypoint   RouteWaypoint?      @relation(fields: [waypointId], references: [id], onDelete: SetNull)
  kind       RouteAnnotationKind
  body       String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  synced     Boolean             @default(false)
  deleted    Boolean             @default(false)

  media RouteMedia[]

  @@index([routeId, createdAt])
  @@index([synced, updatedAt])
  @@map("route_annotation")
}

model RouteMedia {
  id           String         @id @default(cuid())
  annotationId String
  annotation   RouteAnnotation @relation(fields: [annotationId], references: [id], onDelete: Cascade)
  type         RouteMediaType
  order        Int            @default(0)
  localPath    String?
  remoteUrl    String?
  thumbnailUrl String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  synced       Boolean        @default(false)

  @@index([annotationId, order])
  @@index([synced, updatedAt])
  @@map("route_media")
}

model DeletedRoute {
  id        String   @id
  deletedAt DateTime @default(now())

  @@map("deleted_route")
}

model BoatAsset {
  id               String         @id @default(cuid())
  boatId           String
  name             String
  description      String?
  ownership        AssetOwnership
  ownedByUserId    String?
  onLoanFromUserId String?
  installedAt      DateTime?
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  boat           Boat                 @relation(fields: [boatId], references: [id], onDelete: Cascade)
  ownedByUser    User?                @relation("BoatAssetOwner", fields: [ownedByUserId], references: [id], onDelete: SetNull)
  onLoanFromUser User?                @relation("BoatAssetLoanFrom", fields: [onLoanFromUserId], references: [id], onDelete: SetNull)
  purchaseLines  BoatPurchaseLine[]
  workRecords    AssetWork[]
  documentLinks  BoatAssetDocument[]

  @@index([boatId, sortOrder])
  @@map("boat_asset")
}

model BoatPurchase {
  id           String    @id @default(cuid())
  boatId       String
  orgId        String?
  supplierName String?
  purchasedAt  DateTime?
  notes        String?
  totalAmount  Decimal?  @db.Decimal(12, 2)
  currency     String    @default("EUR")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  boat          Boat                   @relation(fields: [boatId], references: [id], onDelete: Cascade)
  org           Consortium?            @relation(fields: [orgId], references: [id], onDelete: SetNull)
  lines         BoatPurchaseLine[]
  documentLinks BoatPurchaseDocument[]
  expenseClaims ExpenseClaim[]
  transactions  OrgTransaction[]

  @@index([boatId, purchasedAt])
  @@index([orgId])
  @@map("boat_purchase")
}

model BoatPurchaseLine {
  id          String   @id @default(cuid())
  purchaseId  String
  description String
  quantity    Decimal? @db.Decimal(12, 3)
  unitPrice   Decimal? @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  assetId     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchase BoatPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  asset    BoatAsset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([purchaseId, sortOrder])
  @@map("boat_purchase_line")
}

model AssetWork {
  id           String        @id @default(cuid())
  assetId      String
  boatId       String
  type         AssetWorkType
  performedAt  DateTime?
  description  String?
  costAmount   Decimal?      @db.Decimal(12, 2)
  costCurrency String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  asset         BoatAsset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  boat          Boat                @relation(fields: [boatId], references: [id], onDelete: Cascade)
  documentLinks AssetWorkDocument[]

  @@index([assetId, performedAt])
  @@index([boatId])
  @@map("asset_work")
}

model BoatAssetDocument {
  id         String @id @default(cuid())
  assetId    String
  documentId String

  asset    BoatAsset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  document BoatDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([assetId, documentId])
  @@map("boat_asset_document")
}

model BoatPurchaseDocument {
  id         String @id @default(cuid())
  purchaseId String
  documentId String

  purchase BoatPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  document BoatDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([purchaseId, documentId])
  @@map("boat_purchase_document")
}

model AssetWorkDocument {
  id         String @id @default(cuid())
  workId     String
  documentId String

  work     AssetWork    @relation(fields: [workId], references: [id], onDelete: Cascade)
  document BoatDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([workId, documentId])
  @@map("asset_work_document")
}

model OrgBankAccount {
  id               String    @id @default(cuid())
  orgId            String
  name             String
  currency         String    @default("EUR")
  openingBalance   Decimal   @default(0) @db.Decimal(12, 2)
  openingBalanceAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  org          Consortium       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  transactions OrgTransaction[]

  @@index([orgId])
  @@map("org_bank_account")
}

model OrgTransaction {
  id                 String          @id @default(cuid())
  orgId              String
  bankAccountId      String
  type               TransactionType
  amount             Decimal         @db.Decimal(12, 2)
  currency           String          @default("EUR")
  occurredAt         DateTime
  description        String
  boatId             String?
  purchaseId         String?
  expenseClaimId     String?         @unique
  counterpartyUserId String?
  createdByUserId    String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  org              Consortium      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bankAccount      OrgBankAccount  @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  boat             Boat?           @relation(fields: [boatId], references: [id], onDelete: SetNull)
  purchase         BoatPurchase?   @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  expenseClaim     ExpenseClaim?   @relation("PaidExpenseClaim", fields: [expenseClaimId], references: [id], onDelete: SetNull)
  counterpartyUser User?           @relation("OrgTransactionCounterparty", fields: [counterpartyUserId], references: [id], onDelete: SetNull)
  createdBy        User            @relation("OrgTransactionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([orgId, occurredAt])
  @@index([boatId])
  @@index([bankAccountId])
  @@map("org_transaction")
}

model ExpenseClaim {
  id                String             @id @default(cuid())
  orgId             String
  claimantUserId    String
  boatId            String?
  purchaseId        String?
  status            ExpenseClaimStatus @default(draft)
  amount            Decimal            @db.Decimal(12, 2)
  currency          String             @default("EUR")
  description       String
  incurredAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  org             Consortium             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  claimant        User                   @relation("ExpenseClaimClaimant", fields: [claimantUserId], references: [id], onDelete: Restrict)
  boat            Boat?                  @relation(fields: [boatId], references: [id], onDelete: SetNull)
  purchase        BoatPurchase?          @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  paidTransaction OrgTransaction?        @relation("PaidExpenseClaim")
  documentLinks   ExpenseClaimDocument[]

  @@index([orgId, status])
  @@index([boatId])
  @@index([claimantUserId])
  @@map("expense_claim")
}

model ExpenseClaimDocument {
  id         String @id @default(cuid())
  claimId    String
  documentId String

  claim    ExpenseClaim       @relation(fields: [claimId], references: [id], onDelete: Cascade)
  document ConsortiumDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([claimId, documentId])
  @@map("expense_claim_document")
}
