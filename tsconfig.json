{
  "include": [
    "src/domain/**/*.ts",
    "src/lib/cn.ts",
    "src/lib/auth-client.ts",
    "src/lib/logbook-*.ts",
    "src/components/AppShell.tsx",
    "src/components/Header.tsx",
    "src/components/ThemeToggle.tsx",
    "src/components/UserMenu.tsx",
    "src/routes/__root.tsx",
    "src/routes/_main/route.tsx",
    "src/routes/_main/index.tsx",
    "src/routes/_main/about.tsx",
    "src/routes/_main/sign-in.tsx",
    "src/routes/_main/reset-password.tsx",
    "src/routes/api/$.tsx",
    "src/router.tsx",
    "src/routeTree.gen.ts",
    "src/server/db.ts",
    "src/server/auth.ts",
    "src/server/email/ses.ts",
    "src/server/hono.ts",
    "src/server/routes/logbook.ts",
    "src/stores/logbook.ts",
    "eslint.config.js",
    "vite.config.ts",
    "prisma.config.ts"
  ],
  "exclude": [
    "src/routes/_main/admin/**",
    "src/server/jobs/**",
    "src/server/geo-features/**",
    "src/lib/angle.ts",
    "src/lib/map-*.ts",
    "src/lib/route-bbox-expand.ts",
    "src/lib/server-maptiler-key.ts",
    "src/lib/tiles.ts",
    "src/lib/tile-idb.ts",
    "src/lib/geo-label-pick.ts",
    "src/lib/csv-parse.ts",
    "src/stores/app-options.ts",
    "src/worker.ts",
    "src/routes/_main/admin/**"
  ],

  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "baseUrl": ".",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
