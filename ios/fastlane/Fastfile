default_platform(:ios)

def apple_account_username
  ENV.fetch('APPLE_ID', 'cremoni@gmail.com')
end

platform :ios do
  desc 'Build a release .ipa (run pnpm cap:sync:staging or cap:sync:prod before archiving)'
  lane :build do
    build_app(
      project: 'App/App.xcodeproj',
      scheme: 'Logbook2.0',
      configuration: 'Release',
      export_method: 'app-store',
      output_directory: 'build',
      output_name: 'Logbook2.0.ipa',
      xcargs: '-allowProvisioningUpdates DEVELOPMENT_TEAM=RPGSNMH65P',
      export_options: {
        method: 'app-store',
        signingStyle: 'automatic',
        teamID: 'RPGSNMH65P',
        uploadSymbols: true,
        uploadBitcode: false,
      },
    )
  end

  desc 'Upload to TestFlight (staging web app — run via pnpm ios:beta)'
  lane :beta do
    build
    upload_to_testflight(
      username: apple_account_username,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false,
    )
  end
end
