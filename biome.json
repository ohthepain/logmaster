{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "files": {
    "includes": [
      "README.md",
      "docs/**/*.md",
      "package.json",
      "tsconfig.json",
      "vite.config.ts",
      "prisma.config.ts",
      "eslint.config.js",
      "biome.json",
      "public/manifest.json",
      "src/**/*.css",
      "src/**/*.json",
      "src/**/*.ts",
      "src/**/*.tsx",
      "!src/routeTree.gen.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": false
  }
}
