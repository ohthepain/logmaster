# Shared octacard Postgres on localhost:5432. Create database: CREATE DATABASE logmaster OWNER octacard;
DATABASE_URL="postgresql://octacard:PASSWORD@localhost:5432/logmaster"
BETTER_AUTH_SECRET="use-openssl-rand-hex-32"
# App URL for links, cookies, OAuth redirects, and better-auth "trusted origin" (must match the address bar, including port — `pnpm dev` uses 3020).
BETTER_AUTH_URL="http://localhost:3020"
# Required for native (Capacitor) builds — HTTPS origin of the deployed API (e.g. https://logmaster.live). Also add capacitor://localhost and https://localhost to TRUSTED_ORIGINS for native auth cookies.
VITE_PUBLIC_APP_URL=""
# Comma-separated extra browser origins allowed for CORS and auth (e.g. preview deploys, capacitor://localhost). Must include your real site https origin in production.
TRUSTED_ORIGINS=""
# Comma-separated admin emails allowed to access /admin and /api/admin (must match signed-in user email).
ADMIN_EMAILS=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AWS SES — identities must be verified in the same region as AWS_REGION (eu-central-1 for deployed envs).
# Local dev: set AWS_SES_FROM_EMAIL and rely on your AWS CLI profile (no static keys needed).
# If AWS_SES_FROM_EMAIL is unset, auth emails are only logged to the console in development.
AWS_REGION="eu-central-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SES_FROM_EMAIL="no-reply@logmaster.live"
SES_CONFIGURATION_SET="logmaster-live"
EMAIL_APP_NAME="logmaster"
S3_BUCKET_PHOTOS=""
# Geo feature + marina tiles (degree folders in S3, served at /api/geo-features and /api/marinas).
S3_BUCKET_GEOJSON=""
# Overpass API for marina tile builds (defaults to kumi.systems, then overpass-api.de).
# OVERPASS_URL="https://overpass.kumi.systems/api/interpreter"

# If "true", password sign-in requires a verified email (link in inbox) before login.
AUTH_REQUIRE_EMAIL_VERIFICATION="false"
# MapTiler: API key for the server tile/style proxies (/api/map-tiles/..., /api/map-style-vector, /api/maptiler-cdn). The server reads process.env first (VITE_MAPTILER_API_KEY, then MAPTILER_API_KEY, then VITE_MAPTILER_KEY), so it matches curl after `source .env`. Prefer a key without HTTP-origin restriction; see docs/offline-maps-and-tiles.md.
# Optional: preset id (topo-v2, base-v4, …) or your MapTiler Cloud **custom** map id — adds “Custom” to the basemap picker and defaults the app to that map when unset in the UI.
VITE_MAPTILER_API_KEY=3NvJsB9SrNM8mZqF2Tfc
VITE_MAPTILER_RASTER_MAP_ID=019dd855-ddd2-78cd-aeab-b579b94bb5f9

